<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.CheckLoadAd"
    android:orientation="vertical">
    <TextView
        android:id="@+id/close_load_ad_page"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="5dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="5dp"
        android:textSize="18sp"
        android:text="Close"
        android:visibility="gone"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">
        <ProgressBar
            android:id="@+id/progress_load_ad_page"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginBottom="50dp" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/animation_load_ad_page"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginBottom="50dp"
            app:lottie_rawRes="@raw/tik_connected"
            app:lottie_loop="true"
            app:lottie_autoPlay="true"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/title_load_ad_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Checking Connection ..."
            android:textSize="18sp"/>
        <TextView
            android:id="@+id/description_load_ad_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Please wait and don't leave this page!" />
    </LinearLayout>
</LinearLayout>