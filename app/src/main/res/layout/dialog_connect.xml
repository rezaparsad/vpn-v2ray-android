<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@color/white"
    android:minWidth="600dp">
    <LinearLayout
        android:id="@+id/back_native"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_gravity="center"
        android:orientation="vertical" />
    <ProgressBar
        android:id="@+id/progress_load_ad_page"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginBottom="50dp"
        android:layout_gravity="center"/>
    <com.airbnb.lottie.LottieAnimationView
        android:layout_gravity="center"
        android:id="@+id/tik_success"
        android:layout_width="200dp"
        android:layout_height="200dp"
        app:lottie_rawRes="@raw/tik_connected"
        app:lottie_loop="true"
        app:lottie_autoPlay="true"
        android:visibility="gone"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:id="@+id/description_load_ad_page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Please wait and don't leave this page!"
            android:textColor="@color/colorBlack"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:textSize="18sp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center">
            <Button
                android:id="@+id/connect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:text="Connecting ..."
                android:paddingStart="60dp"
                android:paddingEnd="60dp"
                android:textColor="@color/white"
                android:backgroundTint="@color/colorPrimary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>